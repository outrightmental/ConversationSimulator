{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.convsim.dev/v0.1/volley-score.schema.json",
  "title": "ConvSim Volley Score",
  "description": "The per-volley scorecard a flyting session produces (runtime output, not pack-authored). One document per volley — the player's and the NPC's alike — carrying every number behind the final score so the scorecard can show its arithmetic and the debrief can expose the raw judge verdict. Like turn-output.schema.json this document has no schema_version: it is generated by the engine, never authored.",
  "type": "object",
  "required": [
    "volley_number",
    "speaker",
    "score",
    "band",
    "gate",
    "composition",
    "craft_metrics",
    "freshness",
    "flags"
  ],
  "additionalProperties": false,
  "properties": {
    "volley_number": {
      "type": "integer",
      "description": "1-based index of this volley within the session, counted per speaker.",
      "minimum": 1
    },
    "speaker": {
      "type": "string",
      "enum": ["player", "npc"]
    },
    "score": {
      "type": "integer",
      "description": "Final composed score. Typical range 0-250: 100 is a solid hit, 180+ is highlight-reel.",
      "minimum": 0
    },
    "band": {
      "type": "string",
      "enum": ["dud", "weak", "solid", "strong", "highlight"]
    },
    "gate": {
      "type": "object",
      "description": "Stage 0 result. A dud scores zero without a foul; a foul scores zero and is recorded against the session.",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "type": "string", "enum": ["ok", "dud", "foul"] },
        "foul": {
          "type": ["string", "null"],
          "enum": [
            "below_the_belt",
            "out_of_fiction",
            "bribing_the_ref",
            "overt_rudeness",
            "anachronism",
            null
          ]
        },
        "reason": { "type": ["string", "null"] },
        "umpire_mock": {
          "type": ["string", "null"],
          "description": "In-character line shown when the gate fired — the umpire mocking an attempt to bribe them, for instance."
        },
        "ends_session": {
          "type": "boolean",
          "default": false,
          "description": "True when this foul ends the session (a repeat below-the-belt)."
        }
      }
    },
    "composition": {
      "type": "object",
      "description": "Stage 4 arithmetic: round(100 * Q * T * F * P * run_on_decay) + bonuses.",
      "required": ["quality", "topicality", "freshness", "difficulty", "base", "bonus_total"],
      "additionalProperties": false,
      "properties": {
        "quality": { "type": "number", "minimum": 0, "maximum": 1, "description": "Q — weighted judge dimensions." },
        "topicality": { "type": "number", "minimum": 1, "description": "T — 1 + the decayed hook bonuses." },
        "freshness": { "type": "number", "minimum": 0, "maximum": 1, "description": "F — clamp(1 - s_max^2, 0.1, 1.0)." },
        "difficulty": { "type": "number", "minimum": 0, "description": "P — the scenario's difficulty multiplier." },
        "run_on_decay": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "base": { "type": "integer", "minimum": 0, "description": "The composed score before bonuses." },
        "bonuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "points"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "enum": ["riposte", "callback", "device_rotation", "compound"]
              },
              "points": { "type": "integer" },
              "evidence": { "type": ["string", "null"] }
            }
          }
        },
        "bonus_total": { "type": "integer" }
      }
    },
    "judge": {
      "type": ["object", "null"],
      "description": "The Stage 3 verdict after hook verification. Null when the judge was unavailable or returned unusable output twice, in which case the volley was scored mechanically and carries the judge_unavailable flag.",
      "additionalProperties": false,
      "properties": {
        "sting": { "type": "integer", "minimum": 0, "maximum": 10 },
        "wit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "craft": { "type": "integer", "minimum": 0, "maximum": 10 },
        "fidelity": { "type": "integer", "minimum": 0, "maximum": 10 },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["trait", "evidence"],
            "additionalProperties": false,
            "properties": {
              "trait": { "type": "string" },
              "evidence": { "type": "string" },
              "discovered": { "type": "boolean", "default": false }
            }
          }
        },
        "themes": { "type": "array", "items": { "type": "string" } },
        "devices": { "type": "array", "items": { "type": "string" } },
        "riposte": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_riposte": { "type": "boolean" },
            "evidence": { "type": ["string", "null"] }
          }
        },
        "callback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_callback": { "type": "boolean" },
            "evidence": { "type": ["string", "null"] }
          }
        },
        "fouls": { "type": "array", "items": { "type": "string" } },
        "umpire_line": { "type": "string" },
        "dropped_hooks": {
          "type": "array",
          "description": "Hook claims the engine refused: the trait was not on the target's attack surface, or the quoted evidence was not actually in the volley.",
          "items": {
            "type": "object",
            "required": ["trait", "reason"],
            "additionalProperties": false,
            "properties": {
              "trait": { "type": "string" },
              "evidence": { "type": ["string", "null"] },
              "reason": {
                "type": "string",
                "enum": ["unknown_trait", "evidence_not_in_volley", "duplicate_trait", "over_hook_cap"]
              }
            }
          }
        }
      }
    },
    "craft_metrics": {
      "type": "object",
      "description": "Stage 1 deterministic metrics. Computed with no model call, so they are identical on every machine.",
      "required": ["word_count", "type_token_ratio", "mean_zipf", "second_person"],
      "additionalProperties": false,
      "properties": {
        "word_count": { "type": "integer", "minimum": 0 },
        "content_word_count": { "type": "integer", "minimum": 0 },
        "type_token_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "mean_zipf": { "type": "number", "description": "Mean Zipf frequency of content words; lower is rarer." },
        "rarity_reward": { "type": "number", "minimum": 0, "maximum": 1 },
        "variety_reward": { "type": "number", "minimum": 0, "maximum": 1 },
        "sound_reward": { "type": "number", "minimum": 0, "maximum": 1 },
        "alliteration_runs": { "type": "integer", "minimum": 0 },
        "assonance_runs": { "type": "integer", "minimum": 0 },
        "rhyme_pairs": { "type": "integer", "minimum": 0 },
        "scansion_regularity": { "type": "number", "minimum": 0, "maximum": 1 },
        "second_person": { "type": "boolean", "description": "Aim check: is the volley actually pointed at the target?" },
        "craft_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Mechanical craft estimate on the judge's 0-10 scale, used when the judge is unavailable."
        },
        "rarest_words": {
          "type": "array",
          "description": "The least common content words in this volley, rarest first — the debrief's \"rarest words that landed\" is an aggregate over these.",
          "items": { "type": "string" },
          "maxItems": 5
        }
      }
    },
    "freshness": {
      "type": "object",
      "description": "Stage 2 novelty.",
      "required": ["value", "s_max", "method"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "s_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string", "enum": ["embedding", "lexical"] },
        "nearest_source": { "type": "string", "enum": ["none", "session", "cliche"] },
        "nearest_label": { "type": ["string", "null"] },
        "theme_uses": {
          "type": "object",
          "description": "How many prior volleys this session leaned on each of this volley's themes.",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "theme_decay": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "heat": {
      "type": "number",
      "description": "Batting-practice heat multiplier in force when this volley was scored (1.0-2.0).",
      "minimum": 1,
      "maximum": 2
    },
    "banked_score": {
      "type": "integer",
      "description": "score * heat, rounded — what this volley actually contributed to the session total.",
      "minimum": 0
    },
    "momentum": {
      "type": "integer",
      "description": "Bout momentum after this exchange was resolved.",
      "minimum": 0,
      "maximum": 100
    },
    "flags": {
      "type": "array",
      "description": "Mechanical flags, surfaced verbatim on the scorecard.",
      "items": {
        "type": "string",
        "enum": [
          "plagiarized_zinger",
          "run_on",
          "gibberish",
          "no_aim",
          "too_short",
          "judge_unavailable",
          "shot_clock_expired",
          "whiff"
        ]
      },
      "uniqueItems": true
    },
    "audience_reaction": {
      "type": ["string", "null"],
      "description": "The scene audience's line for this volley's score band, when the scene declares one."
    }
  }
}
