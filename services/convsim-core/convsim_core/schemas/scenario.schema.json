{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.convsim.dev/v0.1/scenario.schema.json",
  "title": "ConvSim Scenario",
  "description": "Validates an individual scenario YAML file.",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "summary",
    "player_role",
    "npc",
    "rubric",
    "duration",
    "opening",
    "goals"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "A flyting scenario must carry its flyting block, and a flyting block must declare the mode. Either half alone is an authoring mistake the loader cannot repair.",
      "if": {
        "properties": { "mode": { "const": "flyting" } },
        "required": ["mode"]
      },
      "then": { "required": ["flyting"] }
    },
    {
      "if": { "required": ["flyting"] },
      "then": {
        "properties": { "mode": { "const": "flyting" } },
        "required": ["mode"]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.1"]
    },
    "scenario_id": {
      "type": "string",
      "description": "Unique identifier within the pack.",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "mode": {
      "type": "string",
      "enum": ["conversation", "flyting"],
      "default": "conversation",
      "description": "Turn loop the engine runs for this scenario. 'conversation' (the default, and the only mode before schema 0.1 gained this field) scores once at the debrief. 'flyting' scores every player turn as a volley and requires the 'flyting' block.",
      "$comment": "Omitting mode is equivalent to mode: conversation, so every pack authored before this field existed keeps its meaning."
    },
    "flyting": {
      "type": "object",
      "description": "Turn-scored insult-practice configuration. Required when mode is 'flyting' and forbidden otherwise.",
      "required": ["formats"],
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "description": "Play formats this scenario offers. 'bout' is the two-way exchange; 'batting_practice' is the solo drill against a target who never counters.",
          "items": { "type": "string", "enum": ["bout", "batting_practice"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "bout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 8,
              "description": "Exchanges before the higher cumulative score wins (a tie forces a sudden-death volley)."
            },
            "momentum_win": {
              "type": "integer",
              "minimum": 51,
              "maximum": 100,
              "default": 85,
              "description": "Momentum value at which the crowd carries the player out on their shoulders — an immediate win."
            },
            "momentum_k": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 4,
              "default": 1,
              "description": "Multiplier k in the per-exchange momentum shift k * (S_player - S_npc) / 100. Raise it for a crowd that swings hard."
            },
            "riposte_bonus": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50,
              "default": 15,
              "description": "Flat bonus for a judge-verified counter to the opponent's last line."
            },
            "npc_tier": {
              "type": "string",
              "enum": ["milquetoast", "wildean", "unhinged_taunter"],
              "default": "wildean",
              "description": "Difficulty tier of the opponent: maps to persona notes plus sampling configuration."
            }
          }
        },
        "batting_practice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shot_clock_s": {
              "type": "integer",
              "minimum": 5,
              "maximum": 120,
              "default": 20,
              "description": "Per-volley shot clock in seconds. Keeps the drill a reflex exercise rather than an essay contest."
            },
            "formats": {
              "type": "array",
              "items": { "type": "string", "enum": ["timed_90", "set_10", "endless"] },
              "minItems": 1,
              "uniqueItems": true,
              "default": ["timed_90", "set_10", "endless"]
            }
          }
        },
        "difficulty_multiplier": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.5,
          "default": 1,
          "description": "Scenario difficulty multiplier P applied to every composed volley score."
        },
        "lexicon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encouraged": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 40 },
              "maxItems": 60,
              "uniqueItems": true,
              "description": "Period or register diction surfaced as hints at low difficulty."
            },
            "discouraged": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 40 },
              "maxItems": 60,
              "uniqueItems": true,
              "description": "Words that break the register — anachronisms, brand names, modern slang."
            },
            "anachronism_policy": {
              "type": "string",
              "enum": ["off", "penalize", "forbid"],
              "default": "off",
              "description": "off = ignored; penalize = fidelity cost; forbid = a foul worth zero."
            }
          }
        },
        "register": {
          "type": "object",
          "description": "Register constraints the judge scores fidelity against.",
          "additionalProperties": false,
          "properties": {
            "require_surface_politeness": {
              "type": "boolean",
              "default": false,
              "description": "True when the sting must arrive wrapped in a compliment (a Regency ballroom, a diplomatic reception)."
            },
            "overt_rudeness_is_foul": {
              "type": "boolean",
              "default": false,
              "description": "True when naked rudeness scores zero rather than merely losing fidelity points."
            },
            "notes": { "type": "string", "maxLength": 300 }
          }
        },
        "verse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean",
              "default": false,
              "description": "True for mead-hall flyting: alliteration and rough scansion are scored as craft."
            },
            "min_alliteration_run": {
              "type": "integer",
              "minimum": 2,
              "maximum": 6,
              "default": 3,
              "description": "Alliterating content words needed in a run before it counts toward sound play."
            }
          }
        },
        "judge_flavor": {
          "type": "string",
          "maxLength": 300,
          "description": "One or two sentences establishing the umpire's voice for the per-volley commentary line."
        },
        "judge_rubric": {
          "type": "object",
          "description": "Optional rubric whose volley_judge block rebalances dimension weights and supplies calibration anchors. Defaults to the scenario's main rubric.",
          "required": ["ref"],
          "additionalProperties": false,
          "properties": {
            "ref": { "type": "string" }
          }
        }
      }
    },
    "supported_languages": {
      "type": "array",
      "description": "Languages this scenario can be played in, target language first: the first entry is the setup page's default and the language a card is labelled with. Optional — omit to inherit the pack manifest's list.",
      "items": { "type": "string", "pattern": "^[a-z]{2,3}$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "player_role": {
      "type": "object",
      "required": ["label", "brief"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "brief": { "type": "string" }
      }
    },
    "npc": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Relative path to the NPC YAML file."
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string" }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Relative path to the rubric YAML file."
        }
      }
    },
    "duration": {
      "type": "object",
      "required": ["max_turns"],
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "soft_time_limit_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "opening": {
      "type": "object",
      "required": ["npc_says"],
      "additionalProperties": false,
      "properties": {
        "npc_says": { "type": "string" }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "player_visible": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hidden": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "object",
          "description": "Override or extend baseline variables. Each key is a variable name. Value may be a simple integer (sets the default) or a rich object with min/max/default/visibility/max_delta_per_turn.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Shorthand: sets the default value for a baseline variable."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "description": "Full variable definition.",
                "properties": {
                  "min": { "type": "integer", "default": 0 },
                  "max": { "type": "integer", "default": 100 },
                  "default": { "type": "integer" },
                  "visibility": {
                    "type": "string",
                    "enum": ["visible", "hidden"],
                    "default": "visible"
                  },
                  "max_delta_per_turn": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 20
                  }
                }
              }
            ]
          }
        }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "description": "Standardised difficulty system. 'default' names the author's recommended preset. 'options' maps each named preset to its four knobs.",
      "properties": {
        "default": {
          "type": "string",
          "enum": ["warm", "standard", "hard", "adversarial"],
          "description": "Author's recommended preset shown pre-selected in setup UI."
        },
        "options": {
          "type": "object",
          "description": "Per-preset knob overrides. Keys must be preset names.",
          "additionalProperties": false,
          "properties": {
            "warm":        { "$ref": "#/$defs/DifficultyPreset" },
            "standard":    { "$ref": "#/$defs/DifficultyPreset" },
            "hard":        { "$ref": "#/$defs/DifficultyPreset" },
            "adversarial": { "$ref": "#/$defs/DifficultyPreset" }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "when", "npc_instruction"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "when": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "variable", "threshold"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["variable_above"] },
                  "variable": { "type": "string" },
                  "threshold": { "type": "integer" }
                }
              },
              {
                "type": "object",
                "required": ["type", "variable", "threshold"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["variable_below"] },
                  "variable": { "type": "string" },
                  "threshold": { "type": "integer" }
                }
              },
              {
                "type": "object",
                "required": ["type", "value"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["max_turns"] },
                  "value": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "required": ["type", "flag_id"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["flag"] },
                  "flag_id": { "type": "string", "pattern": "^[a-z0-9_]+$" }
                }
              }
            ]
          },
          "npc_instruction": { "type": "string" },
          "repeat": {
            "type": "boolean",
            "default": false,
            "description": "If true, the event may fire on every turn the condition is met. If false (default), fires at most once per session."
          }
        }
      }
    },
    "replay_seed": {
      "type": "integer",
      "description": "Optional integer seed for deterministic replay. When set, the runtime uses this seed to reproduce the same LLM-sampled sequence across replays.",
      "minimum": 0
    },
    "response_style": {
      "type": "object",
      "description": "Optional hints controlling NPC response length and register.",
      "additionalProperties": false,
      "properties": {
        "max_words": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500,
          "description": "Soft target for maximum NPC utterance length in words."
        },
        "verbosity": {
          "type": "string",
          "enum": ["terse", "moderate", "verbose"],
          "description": "How much detail the NPC typically provides unprompted."
        },
        "formality": {
          "type": "string",
          "enum": ["casual", "professional", "formal"],
          "description": "Language register the NPC should maintain."
        }
      }
    },
    "ladder_position": {
      "type": "string",
      "enum": ["intro", "practice", "stretch"],
      "description": "Position on the curriculum ladder. intro = foundational entry point for new learners; practice = core repetitions for building fluency; stretch = challenge for experienced practitioners."
    },
    "taught_dimensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "uniqueItems": true,
      "description": "Rubric dimension IDs that this scenario explicitly introduces or teaches."
    },
    "tested_dimensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "uniqueItems": true,
      "description": "Rubric dimension IDs that this scenario meaningfully scores and provides feedback on."
    },
    "ending_conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "variable", "threshold"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["variable_above"] },
                "variable": { "type": "string" },
                "threshold": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["type", "variable", "threshold"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["variable_below"] },
                "variable": { "type": "string" },
                "threshold": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["type", "value"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["max_turns"] },
                "value": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "failure": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "variable", "threshold"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["variable_above"] },
                "variable": { "type": "string" },
                "threshold": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["type", "variable", "threshold"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["variable_below"] },
                "variable": { "type": "string" },
                "threshold": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["type", "value"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["max_turns"] },
                "value": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "timeout": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "variable", "threshold"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["variable_above"] },
                "variable": { "type": "string" },
                "threshold": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["type", "variable", "threshold"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["variable_below"] },
                "variable": { "type": "string" },
                "threshold": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["type", "value"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["max_turns"] },
                "value": { "type": "integer", "minimum": 1 }
              }
            }
          ],
          "description": "Optional explicit timeout condition (turn-count-based timeout is always enforced via duration.max_turns)."
        }
      }
    }
  },
  "$defs": {
    "DifficultyPreset": {
      "type": "object",
      "additionalProperties": false,
      "description": "Knob values for one named difficulty preset.",
      "properties": {
        "patience": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Tolerance before the NPC disengages (higher = more patient)."
        },
        "volatility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "State-meter sensitivity per turn (higher = meters shift more)."
        },
        "disclosure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "How freely the NPC volunteers information (higher = more open)."
        },
        "time_pressure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Turn-budget urgency the NPC conveys (higher = more time pressure)."
        },
        "label": {
          "type": "string",
          "description": "Short human-readable label shown in setup UI (e.g. 'Warm-up')."
        },
        "description": {
          "type": "string",
          "maxLength": 120,
          "description": "One-line description of what changes at this preset, shown in setup UI."
        }
      }
    }
  }
}
