<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  Entitlements of every program the Mac App Store edition starts: the engine
  (convsim-core) and llama-server. A sandboxed app's child program must be
  signed with exactly these two, so it runs in the app's own sandbox and
  inherits the app's entitlements (network server, microphone). Anything more
  and macOS refuses to start it.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
