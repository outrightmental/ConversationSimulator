# SPDX-License-Identifier: Apache-2.0
#
# The studio's Apple signing material lives encrypted (MATCH_PASSWORD) on
# UmlautHero's private `signing` branch, which UmlautHero's own releases
# create and renew. One Apple team, one set of certificates: Apple allows
# only a few of each kind, so the apps share them. This repository is public
# and keeps none of it.
#
# MATCH_GIT_BASIC_AUTHORIZATION is base64("x-access-token:<token>") for a token
# that may read and write UmlautHero's contents (publishing/MAC_APP_STORE.md §5).
git_url("https://github.com/outrightmental/UmlautHero.git")
git_branch("signing")
storage_mode("git")
type("appstore")
git_basic_authorization(ENV["MATCH_GIT_BASIC_AUTHORIZATION"])
