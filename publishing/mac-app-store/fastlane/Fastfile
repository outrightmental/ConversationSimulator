# The Mac App Store lane (publishing/MAC_APP_STORE.md), run by
# .github/workflows/mac-app-store.yml from publishing/mac-app-store/:
#
#   bundle exec fastlane mac store app:<path to .app> pkg:<path to .pkg> upload:true
#
# Signing material is the studio's, shared with UmlautHero (same Apple team):
# match keeps the Apple Distribution and Mac Installer Distribution
# certificates, encrypted, on UmlautHero's private `signing` branch, and adds
# this app's Mac App Store profile there the first time. See Matchfile.

default_platform(:mac)

BUNDLE_ID = "com.outrightmental.convsim"

platform :mac do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
    )
  end

  desc "Sign the app for the Mac App Store, pack the .pkg, and send it to TestFlight"
  lane :store do |options|
    app = File.expand_path(options.fetch(:app))
    pkg = File.expand_path(options.fetch(:pkg))
    upload = options[:upload].to_s == "true"
    key = api_key
    setup_ci if is_ci

    # Creates this app's Mac App Store profile on the first run (the bundle id
    # must already be registered, publishing/MAC_APP_STORE.md §2) and reuses the
    # team's two certificates; later runs only fetch.
    match(
      type: "appstore",
      platform: "macos",
      app_identifier: BUNDLE_ID,
      additional_cert_types: ["mac_installer_distribution"],
      readonly: false,
      api_key: key,
    )
    profile = ENV.fetch("sigh_#{BUNDLE_ID}_appstore_macos_profile-path")

    identities = sh("security", "find-identity", "-v", log: false)
    app_identity = identities[/"((?:Apple Distribution|3rd Party Mac Developer Application): [^"]+)"/, 1]
    installer_identity = identities[/"((?:3rd Party Mac Developer Installer|Mac Installer Distribution): [^"]+)"/, 1]
    UI.user_error!("No Apple Distribution identity in the keychain") unless app_identity
    UI.user_error!("No Mac Installer Distribution identity in the keychain") unless installer_identity

    build_number =
      if upload
        begin
          latest_testflight_build_number(
            api_key: key, app_identifier: BUNDLE_ID, platform: "osx", initial_build_number: 0,
          ) + 1
        rescue => e
          UI.user_error!("App Store Connect has no macOS app for #{BUNDLE_ID} yet " \
                         "(publishing/MAC_APP_STORE.md §3): #{e.message}")
        end
      else
        1
      end

    sh("bash", File.expand_path("../../../scripts/sign-mac-app-store.sh", __dir__),
       app, profile, app_identity, installer_identity, build_number.to_s, pkg)

    next unless upload

    upload_to_testflight(
      api_key: key,
      pkg: pkg,
      app_platform: "osx",
      skip_waiting_for_build_processing: true,
    )
  end
end
